# ══════════════════════════════════════════════════════════
# 🎯 META ADS (FACEBOOK & INSTAGRAM) CONFIGURAÇÃO
# ══════════════════════════════════════════════════════════

# Token de Acesso da Meta Marketing API
# Obtenha em: https://developers.facebook.com/tools/explorer/
META_ACCESS_TOKEN=SEU_META_ACCESS_TOKEN_AQUI

# ID da Conta de Anúncios (apenas números, sem o prefixo 'act_')
META_AD_ACCOUNT_ID=000000000000000

# App ID e Secret (usados para renovar token via OAuth)
META_APP_ID=SEU_META_APP_ID
META_APP_SECRET=SEU_META_APP_SECRET

# ══════════════════════════════════════════════════════════
# 🎯 GOOGLE ADS CONFIGURAÇÃO
# ══════════════════════════════════════════════════════════
GOOGLE_ADS_DEVELOPER_TOKEN=SEU_DEVELOPER_TOKEN
GOOGLE_ADS_CLIENT_ID=SEU_CLIENT_ID.apps.googleusercontent.com
GOOGLE_ADS_CLIENT_SECRET=SEU_CLIENT_SECRET
GOOGLE_ADS_LOGIN_CUSTOMER_ID=0000000000
GOOGLE_ADS_REFRESH_TOKEN=SEU_REFRESH_TOKEN
